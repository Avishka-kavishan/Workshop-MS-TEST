# ====================================================================
# Workshop Management System - Environment Variables
# ====================================================================

# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=[mode]
# Examples:
#   Local:      postgresql://postgres:postgres@localhost:5432/workshop_ms
#   Supabase:   postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require
#   Neon:       postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
#   Vercel PG:  postgresql://[user]:[password]@[host]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workshop_ms

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=workshop-management-system-secret-key-2026

# Node Environment
NODE_ENV=development
